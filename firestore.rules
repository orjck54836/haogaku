rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每個人只能讀寫自己的學習資料
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 會話分析紀錄。
    //
    // **規則不會從 users/{uid} 往下繼承到子集合**，所以這條一定要自己寫，
    // 漏了的話 app 一打開就讀不到紀錄（而且錯誤被 catch 掉，只會看起來像沒資料）。
    //
    // 搬出 users 文件的原因見 lib/reports.ts：那份文件是整份重寫的，
    // 分析跟著走等於每次加 XP 都重傳一次全部紀錄。
    // 只有本人能讀寫，和 users 一樣——這是私人資料，不像排行榜要對外開放。
    match /users/{uid}/reports/{reportId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 排行榜：登入者都讀得到，但只能寫自己那一筆。
    //
    // 這個集合是刻意和 users 分開的——users 裡有單字本和自我介紹，
    // 不能為了做榜單就把整份資料開放。這裡只收榜上要顯示的欄位，
    // 而且用 hasOnly 擋住：有人改 client 想偷塞欄位（例如 email）也寫不進來。
    //
    // xp 只檢查型別和下限，不防作弊——真要防得把加分搬到 Cloud Functions。
    // 以目前的規模，擋住「亂塞欄位」和「改別人的分數」就夠了。
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'jaName', 'photo', 'xp', 'lv', 'streak', 'lessons', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 12
        && request.resource.data.jaName is string
        && request.resource.data.jaName.size() <= 12
        // 只收網址字串，長度擋住有人拿這個欄位塞 base64 圖片進來
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 500
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.lv is int
        && request.resource.data.streak is int
        && request.resource.data.lessons is int;
    }

    // AI 使用次數只有後端能寫
    // AI 產生的課程只有後端能讀寫（可在 Firebase 主控台檢查、修改）
    match /lessons/{id} {
      allow read, write: if false;
    }
    // 單字例句的共用快取。全使用者共用一份，所以 client 一律讀不到也寫不到：
    // 開放讀取等於讓人跳過額度直接撈別人產生過的內容
    match /examples/{id} {
      allow read, write: if false;
    }
    match /ttsUsage/{uid} {
      allow read, write: if false;
    }
    match /usage/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 成本記錄（每人每天一筆，只有後端寫得進去）。
    //
    // 讀取限制成「admins/{uid} 這份文件存在的人」，而不是把 uid 寫死在規則裡：
    // 規則改一次就要重新部署，而且 uid 寫在版控裡不好看。
    // 要開通後台，在 Firebase 主控台手動建一筆空的 admins/{你的 uid} 就好。
    //
    // 這份資料跨所有使用者，等於整個營運數字——除了 admin 誰都不該讀得到。
    match /costs/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // 誰是 admin。寫入對所有人關閉：能自己把自己加進來的話，上面那條就形同虛設
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 內容檢舉。
    //
    // AI 是即時生成的，不可能事前審完每一句，所以 App Store 會看「使用者遇到
    // 不當內容時能不能回報」。這裡只開 create：檢舉送得進來，但誰都讀不到、
    // 也改不掉自己送出的那一筆（包含檢舉人自己）——檢舉內容裡有對話片段，
    // 讀取權限開給任何人都是把別人的會話攤開。處理從 Firebase 主控台看。
    //
    // hasOnly 鎖欄位的理由和排行榜一樣：擋住有人改 client 往這裡塞東西。
    match /contentReports/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'scenario', 'reason', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
    }

    // 訂閱事件（開通、續訂、升降級、過期、交接、驗證失敗），只增不改。
    //
    // entitlements 只有「現在是什麼方案」，每次驗證都覆蓋；Cloud Logging 30 天就清掉。
    // 沒有這份的話，一個月前的扣款爭議查不到任何東西。只有後端寫得進去、只有 admin 讀得到——
    // 這是跨所有使用者的營收紀錄，和 costs 同一個等級。
    match /subscriptionEvents/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // 手機端回報的錯誤和購買失敗紀錄（見 src/lib/errlog.ts）。
    //
    // 和內容檢舉同一個做法：只開 create，本人也讀不回去、改不掉。
    // 欄位和長度都鎖死，擋住有人改 client 拿這裡當免費的儲存空間。
    match /clientLogs/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'message', 'detail', 'app', 'os', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['purchase', 'error']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 6000
        && request.resource.data.app is string
        && request.resource.data.app.size() <= 40
        && request.resource.data.os is string
        && request.resource.data.os.size() <= 40
        && request.resource.data.createdAt is number;
    }

    // 哪一筆 Apple 訂閱已經綁給哪個 uid（文件 id 是 originalTransactionId）。
    //
    // 沒有這份的話，一個人買一份訂閱，拿同一組 Apple ID 在 N 個帳號上各驗一次，
    // N 個帳號都會變成付費。讀寫都對所有人關閉：這是防作弊用的，
    // 開讀取等於告訴人家哪些交易號還沒被綁走。
    match /subscriptionClaims/{originalTransactionId} {
      allow read, write: if false;
    }

    // 付費資格。
    //
    // **寫入對所有人關閉**，連本人都不行——這是決定額度的那份資料，
    // 手機改得動的話等於改個 client 就免費升級。只有 Cloud Functions
    // （admin SDK 會繞過這些規則）寫得進去，之後接 IAP 時由收據驗證寫。
    // 本人可讀，是為了讓畫面顯示目前方案而不必多打一支 API。
    //
    // profile.plan 存在手機上，只能拿來顯示，絕對不能拿來決定額度。
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
